# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*.yoursaas.lk

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=saas_booking
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Settings
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=bookings@yoursaas.lk

# SMS (Notify.lk)
NOTIFY_LK_USER_ID=your-notify-lk-user-id
NOTIFY_LK_API_KEY=your-notify-lk-api-key
NOTIFY_LK_SERVICE_ID=your-service-id

# PayHere (Payments)
PAYHERE_MERCHANT_ID=your-payhere-merchant-id
PAYHERE_MERCHANT_SECRET=your-payhere-merchant-secret
PAYHERE_SANDBOX_MODE=True

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Frontend URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
